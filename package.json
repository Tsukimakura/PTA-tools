{
  "name": "pta-tools",
  "version": "1.0.0",
  "description": "An automation and utility toolkit for the Pintia (PTA) platform.",
  "bin": {
    "pta": "bin/pta.js",
    "pta-tools": "bin/pta-cli.js",
    "pta-monitor": "bin/pta-monitor.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "monitor": "node bin/pta-monitor.js",
    "cli": "node bin/pta-cli.js",
    "todo": "node bin/pta.js todo",
    "test": "node --test",
    "check": "node --check bin/*.js src/**/*.js && npm test"
  },
  "keywords": [
    "pta",
    "puppeteer",
    "monitor"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "inquirer": "^8.2.7",
    "puppeteer": "^22.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
